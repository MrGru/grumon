(
    chapters: [
        (number: 1, start_level: "Village", start_feet: Some((232, 204)),
         start_effects: [SetFlag("fx.blackout", 1), Card("ch1_title"), Dialogue("ch1_prologue")]),
    ],

    // ------------------------------------------------------------------
    // Enemies
    // ------------------------------------------------------------------
    skills: [
        (id: "da_tru_can", ap: 1, target: Enemy, melee: true, effects: [Damage(power: 100)]),
        (id: "da_tru_huc", ap: 1, target: Enemy, melee: true, element: Tho, windup: Some(450),
         effects: [Damage(power: 190)]),
        (id: "hac_y_chem", ap: 1, target: Enemy, melee: true, effects: [Damage(power: 100)]),
        (id: "hac_y_dam_lien", ap: 1, target: Enemy, melee: true, cooldown: 2,
         effects: [Damage(power: 60, hits: 2)]),
        (id: "huyet_ho_trao", ap: 1, target: Enemy, melee: true, element: Hoa, effects: [Damage(power: 120)]),
        (id: "pha_tran_quyen", ap: 1, target: Enemy, cooldown: 3, element: Hoa,
         effects: [Damage(power: 70), BreakNode]),
        (id: "huyet_sat_tram", ap: 1, target: Enemy, element: Hoa, windup: Some(600),
         effects: [Damage(power: 260)]),
        (id: "ho_gam", ap: 1, target: AllEnemies, cooldown: 2, effects: [Damage(power: 50)]),
        (id: "lang_can", ap: 1, target: Enemy, melee: true, effects: [Damage(power: 100)]),
        (id: "lang_dau_can_xe", ap: 1, target: Enemy, melee: true, element: Thuy, windup: Some(380),
         effects: [Damage(power: 260)]),
        (id: "lang_nha_trao", ap: 1, target: Enemy, melee: true, element: Kim, effects: [Damage(power: 110)]),
        (id: "lang_nha_phi_tieu", ap: 1, target: Enemy, element: Kim,
         effects: [Damage(power: 50, interrupt: true), Status(id: Doc, turns: 2)]),
        (id: "lang_nha_hu", ap: 1, target: Ally, cooldown: 3, effects: [Haste(300)]),
        (id: "lang_nha_cuong_hoa", ap: 1, target: SelfOnly, cooldown: 5,
         effects: [Status(id: CuongCong, turns: 3), HealPct(8)]),
    ],

    enemies: [
        (id: "da_tru", element: Tho, sprite: Some("gfx/enemies/da_tru.png"),
         stats: (hp: 70, ll: 0, atk: 11, spi: 0, def: 3, tp: 24),
         skills: ["da_tru_huc", "da_tru_can"],
         ai: [(when: EveryNth(3, 1), skill: "da_tru_huc", target: Front),
              (when: Always, skill: "da_tru_can", target: Front)],
         tu_vi: 10, drops: [("da_tru_nanh", 1)], archetype: Channeler),
        (id: "hac_y_tay_sai", element: Vo, sheet: 4, tint: Some((0.38, 0.36, 0.45)),
         stats: (hp: 72, ll: 0, atk: 12, spi: 0, def: 4, tp: 36),
         skills: ["hac_y_dam_lien", "hac_y_chem"],
         ai: [(when: EveryNth(3, 2), skill: "hac_y_dam_lien", target: LowestHp),
              (when: Always, skill: "hac_y_chem", target: Front)],
         tu_vi: 10, archetype: Assassin),
        (id: "do_cuong", element: Hoa, sheet: 7, tint: Some((1.0, 0.62, 0.55)), boss: true, invulnerable: true,
         stats: (hp: 999, ll: 0, atk: 26, spi: 0, def: 30, tp: 30),
         skills: ["huyet_sat_tram", "pha_tran_quyen", "ho_gam", "huyet_ho_trao"],
         ai: [(when: EveryNth(4, 1), skill: "huyet_sat_tram", target: LowestHp),
              (when: FormationPhaseAtLeast(1), skill: "pha_tran_quyen", target: FormationNode),
              (when: EveryNth(3, 2), skill: "ho_gam", target: AllFoes),
              (when: Always, skill: "huyet_ho_trao", target: Random)],
         archetype: FormationBreaker),
        (id: "linh_lang", element: Thuy, sprite: Some("gfx/enemies/linh_lang.png"),
         stats: (hp: 26, ll: 0, atk: 7, spi: 0, def: 3, tp: 70),
         skills: ["lang_can"],
         ai: [(when: Always, skill: "lang_can", target: LowestHp)],
         tu_vi: 8, drops: [("linh_lang_nanh", 1)], archetype: Assassin),
        (id: "lang_dau", element: Thuy, sprite: Some("gfx/enemies/lang_dau.png"),
         stats: (hp: 64, ll: 0, atk: 9, spi: 0, def: 4, tp: 44),
         skills: ["lang_dau_can_xe", "lang_can"],
         ai: [(when: EveryNth(2, 0), skill: "lang_dau_can_xe", target: Front),
              (when: Always, skill: "lang_can", target: LowestHp)],
         tu_vi: 15, drops: [("linh_lang_nanh", 1)], archetype: Channeler),
        (id: "lang_nha", element: Kim, sheet: 5, tint: Some((0.62, 0.64, 0.72)), boss: true,
         stats: (hp: 250, ll: 40, atk: 20, spi: 10, def: 8, tp: 50),
         skills: ["lang_nha_phi_tieu", "lang_nha_cuong_hoa", "lang_nha_hu", "lang_nha_trao"],
         ai: [(when: FoeCharging(2), skill: "lang_nha_phi_tieu", target: Charging, reactive: true),
              (when: SelfHpBelow(50), skill: "lang_nha_cuong_hoa", target: SelfUnit),
              (when: EveryNth(4, 2), skill: "lang_nha_hu", target: LowestHpAlly),
              (when: Always, skill: "lang_nha_trao", target: Front)],
         tu_vi: 60, drops: [("linh_lang_nanh", 1)], archetype: Interrupter),
    ],

    encounters: [
        (id: "ch1_da_tru", enemies: [("da_tru", Front)], objective: DefeatAll, background: "forest_day",
         on_victory: [SetFlag("ch1.da_tru_defeated", 1), Dialogue("ch1_da_tru_after")],
         hints: ["hint.ch1_da_tru.1", "hint.ch1_da_tru.2", "hint.ch1_da_tru.3"]),
        (id: "ch1_hac_y", enemies: [("hac_y_tay_sai", Front)], objective: DefeatAll, background: "village_raid",
         on_victory: [SetFlag("ch1.hac_y_defeated", 1), Dialogue("ch1_hac_y_after")],
         hints: ["hint.ch1_hac_y.1"]),
        (id: "ch1_dem_mua", enemies: [("do_cuong", Front), ("hac_y_tay_sai", Middle)],
         guests: [(character: "ong_mac", slot: Front, hp_pct_if: Some(("ch1.saved_dau", 75)))],
         formation: Some("ho_tam_tran"), objective: FormationPhase(3), protect: ["ong_mac"], music: Some("raid"),
         background: "village_raid",
         on_victory: [SetFlag("ch1.ong_mac_dead", 1), Dialogue("ch1_ong_mac_death")],
         hints: ["hint.ch1_dem_mua.1", "hint.ch1_dem_mua.2", "hint.ch1_dem_mua.3"]),
        (id: "ch1_lang_dem", enemies: [("lang_dau", Front), ("linh_lang", Front), ("linh_lang", Middle)],
         objective: DefeatAll, background: "forest_night",
         on_victory: [SetFlag("ch1.lang_dem_defeated", 1), Dialogue("ch1_lang_dem_after")],
         hints: ["hint.ch1_lang_dem.1", "hint.ch1_lang_dem.2"]),
        (id: "ch1_lang_nha", enemies: [("lang_nha", Front), ("linh_lang", Front)],
         objective: DefeatAll, background: "snow_night", tu_vi: 20,
         on_victory: [SetFlag("ch1.lang_nha_defeated", 1), GiveItem("thu_lenh_dau_may", 1), Dialogue("ch1_after_lang_nha")],
         hints: ["hint.ch1_lang_nha.1", "hint.ch1_lang_nha.2", "hint.ch1_lang_nha.3", "hint.ch1_lang_nha.4"]),
    ],

    // ------------------------------------------------------------------
    // Quests
    // ------------------------------------------------------------------
    quests: [
        (id: "ch1_hai_thuoc", chapter: 1, kind: Main, giver: Some("ong_mac"),
         objectives: [
            (id: "gather", done_when: Any([HasItem("thanh_tam_thao", 3), Flag("ch1.herbs_delivered")])),
            (id: "return", done_when: Flag("ch1.herbs_delivered")),
         ],
         rewards: [GiveMoney(20)], on_complete: [StartQuest("ch1_le_hoi")]),
        (id: "ch1_le_hoi", chapter: 1, kind: Main, giver: Some("ong_mac"),
         objectives: [(id: "meet", done_when: Flag("ch1.festival_done"))],
         on_complete: [StartQuest("ch1_huyet_kiep")]),
        (id: "ch1_huyet_kiep", chapter: 1, kind: Main,
         objectives: [
            // Later raid events also count, so the chain never stalls on this trigger.
            (id: "enter", done_when: Any([Flag("ch1.raid_entered"), Flag("ch1.hac_y_defeated"), Flag("ch1.ong_mac_dead")])),
            (id: "find", done_when: Flag("ch1.ong_mac_dead")),
         ],
         on_complete: [StartQuest("ch1_chay_tron")]),
        (id: "ch1_chay_tron", chapter: 1, kind: Main, giver: Some("ong_mac"),
         objectives: [
            (id: "forest", done_when: Flag("ch1.lang_dem_defeated")),
            (id: "shrine", done_when: Flag("ch1.awakened")),
            (id: "survive", done_when: Flag("ch1.lang_nha_defeated")),
         ],
         on_complete: [StartQuest("ch1_binh_minh")]),
        (id: "ch1_binh_minh", chapter: 1, kind: Main,
         objectives: [
            (id: "bury", done_when: Flag("ch1.buried")),
            (id: "token", done_when: Flag("ch1.token_found")),
            (id: "farewell", done_when: Flag("ch1.complete")),
         ]),
        (id: "ch1_dieu", chapter: 1, kind: Side, giver: Some("be_dau"),
         objectives: [
            (id: "find", done_when: Any([HasItem("con_dieu", 1), Flag("ch1.kite_returned")])),
            (id: "return", done_when: Flag("ch1.kite_returned")),
         ],
         rewards: [GiveItem("soi_nem", 4)], fail_when: Some(Flag("ch1.raid_started"))),
        (id: "ch1_chao_ca", chapter: 1, kind: Side, giver: Some("thim_ba"),
         objectives: [
            (id: "fish", done_when: Any([HasItem("ca_suoi", 1), Flag("ch1.fish_delivered")])),
            (id: "return", done_when: Flag("ch1.fish_delivered")),
         ],
         rewards: [GiveItem("banh_dau_xanh", 3), GiveItem("khoi_me_huong", 1)],
         fail_when: Some(Flag("ch1.raid_started"))),
        (id: "ch1_tram_go", chapter: 1, kind: Side, giver: Some("to_thanh_lien"),
         objectives: [
            (id: "wood", done_when: Any([HasItem("go_dao", 1), HasItem("tram_go_hoa_sen", 1)])),
            (id: "knife", done_when: Any([HasItem("dao_khac", 1), HasItem("tram_go_hoa_sen", 1)])),
            (id: "carve", done_when: HasItem("tram_go_hoa_sen", 1)),
         ],
         fail_when: Some(Flag("ch1.raid_started"))),
    ],

