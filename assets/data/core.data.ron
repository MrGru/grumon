        (id: "au_duong_liet", sheet: 7, element: Hoa,
         base: (hp: 80, ll: 26, atk: 12, spi: 10, def: 5, tp: 36),
         growth: (hp: 36, ll: 20, atk: 7, spi: 5, def: 3, tp: 5),
         skills: ["liet_hoa_phan_thien", "xich_viem_bao"], artifacts: ["xich_viem_chau"]),
        (id: "ta_vo_uu", sheet: 4, element: Hoa, slot: Middle,
         base: (hp: 74, ll: 34, atk: 8, spi: 12, def: 4, tp: 40),
         growth: (hp: 30, ll: 24, atk: 4, spi: 7, def: 2, tp: 6),
         skills: ["hon_hoa_phe_linh"], artifacts: ["chieu_hon_phien"]),
        (id: "to_thanh_lien", sheet: 6, element: Thuy, slot: Back,
         base: (hp: 72, ll: 36, atk: 6, spi: 13, def: 4, tp: 38),
         growth: (hp: 30, ll: 26, atk: 3, spi: 7, def: 3, tp: 6),
         skills: ["moc_linh_hoi_xuan", "thanh_moc_cham"], artifacts: ["ngu_hanh_ky"]),
    ],

    // Map music; `music_by_time` overrides it for a time of day.
    levels: [
        (id: "Village", music: "village",
         music_by_time: {Night: "night", Raid: "raid", Dawn: "sorrow"}),
        (id: "Forest", music: "forest", music_by_time: {Night: "night", Raid: "night", Dawn: "sorrow"}),
        (id: "Snowfield", music: "forest", music_by_time: {Night: "night", Raid: "night", Dawn: "sorrow"}),
