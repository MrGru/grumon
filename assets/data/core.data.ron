// Shared definitions: items, techniques, artifacts, formations, playable characters.
// Player-facing text lives in assets/locale/vi-VN/core.locale.ron (keys derived from IDs).
(
    items: [
        // --- Battle consumables ---
        (id: "banh_dau_xanh", category: Medicine, rarity: Common, price: 4,
         battle_use: [HealPct(30)], target: Ally),
        (id: "soi_nem", category: Medicine, rarity: Common, price: 1,
