        (id: "huyen_anh_phan_than", ap: 1, ll: 8, cooldown: 2, target: Ally,
         effects: [Status(id: HuAnh, turns: 0)]),
        (id: "xich_viem_bao", ap: 2, ll: 6, cooldown: 1, target: Enemy, element: Hoa,
         effects: [ConsumeChargeDamage(power_per_stage: 120, scaling: Spi), Status(id: Bong, turns: 2)]),
        (id: "hon_dang_phe_anh", ap: 1, ll: 0, cooldown: 2, target: Enemy,
         effects: [DrainLl(20)]),
        (id: "truy_phong_bo", ap: 1, ll: 4, cooldown: 3, target: Ally,
         effects: [Haste(300)]),
        (id: "bach_thao_luyen", ap: 2, ll: 15, cooldown: 4, target: AllAllies, windup: Some(800),
         effects: [HealPct(35), Cleanse]),
        (id: "pha_son_tran", ap: 2, ll: 12, cooldown: 3, target: Enemy, element: Tho,
         effects: [StunIfChanneling(else_power: 80)]),
        (id: "kiem_phoi_tram", ap: 2, ll: 8, target: Enemy, melee: true, element: Kim, chargeable: true,
         effects: [Damage(power: 170)]),
        (id: "chieu_hon_trieu", ap: 2, ll: 10, cooldown: 4, target: SelfOnly,
         effects: [Summon("oan_hon_ve")]),
        // --- Companion Tụ khí techniques (Ch2+) ---
        // Diệp Hàn Sương: sword combo, one more cut at stage 2.
        (id: "thanh_van_kiem_quyet", ap: 2, ll: 10, target: Enemy, element: Kim, chargeable: true,
         effects: [Damage(power: 75, hits: 2)],
         charge_bonus: [(stage: 2, effects: [Damage(power: 75)]),
                        (stage: 3, effects: [Status(id: PhaGiap, turns: 2)])]),
        // Diệp Hàn Sương: freezing palm, slows from stage 1, stuns at stage 3.
        (id: "han_bang_chuong", ap: 2, ll: 12, target: Enemy, element: Thuy, chargeable: true,
         effects: [Damage(power: 130, scaling: Spi)],
         charge_bonus: [(stage: 1, effects: [Status(id: Cham, turns: 2)]),
                        (stage: 3, effects: [Status(id: Choang, turns: 1)])]),
        // Âu Dương Liệt: fire over every enemy, burns from stage 2.
        (id: "liet_hoa_phan_thien", ap: 3, ll: 18, target: AllEnemies, element: Hoa, chargeable: true,
         effects: [Damage(power: 80, scaling: Spi)],
         charge_bonus: [(stage: 2, effects: [Status(id: Bong, turns: 2)])]),
        // Tạ Vô Ưu: soul fire that drinks Linh lực; seals at stage 3.
        (id: "hon_hoa_phe_linh", ap: 2, ll: 6, target: Enemy, element: Hoa, chargeable: true,
         effects: [Damage(power: 90, scaling: Spi), DrainLl(10)],
         charge_bonus: [(stage: 2, effects: [DrainLl(15)]),
                        (stage: 3, effects: [Status(id: PhongAn, turns: 1)])]),
        // Tô Thanh Liên: healing rain for the party; cleanses at stage 2, wards at 3.
        (id: "moc_linh_hoi_xuan", ap: 2, ll: 16, target: AllAllies, element: Moc, chargeable: true,
         effects: [Heal(power: 70, scaling: Spi)],
         charge_bonus: [(stage: 2, effects: [Cleanse]),
                        (stage: 3, effects: [Status(id: HoTam, turns: 1)])]),
    ],

    artifacts: [
        (id: "tu_linh_ho_lo", tier: 1, active: Some("phong_linh"), charges_per_battle: Some(2),
         passives: [StoreLl(30)]),
