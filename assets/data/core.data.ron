        (id: "duong_sinh_quyet", ap: 2, ll: 14, target: Ally, element: Moc,
         effects: [Heal(power: 160, scaling: Spi), Cleanse]),
        // --- Artifact actives ---
        (id: "phong_linh", ap: 1, ll: 0, target: SelfOnly,
         effects: [ReleaseStoredLl, GainCharge(1)]),
        (id: "huyen_quy_ho_the", ap: 1, ll: 6, cooldown: 1, target: Ally,
         effects: [Shield(power: 60, scaling: Spi, flat: 30)]),
        (id: "thanh_van_kiem_vu", ap: 2, ll: 10, cooldown: 1, target: Enemy, element: Kim,
