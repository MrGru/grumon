        (id: "ca_suoi", category: Material, rarity: Common, price: 2),
        // --- Quest items ---
        (id: "con_dieu", category: Quest, rarity: Common),
        (id: "dao_khac", category: Quest, rarity: Common),
        (id: "tram_go_hoa_sen", category: Quest, rarity: Uncommon),
        (id: "tan_ngoc", category: Quest, rarity: Legendary),
        (id: "so_thuoc_ong_mac", category: Quest, rarity: Rare),
        (id: "lenh_bai_ngoai_mon", category: Quest, rarity: Rare),
        (id: "thu_lenh_dau_may", category: Quest, rarity: Rare),
    ],

    skills: [
        // --- Protagonist ---
        (id: "quet_gay", ap: 2, ll: 0, target: AllEnemies, melee: false,
         effects: [Damage(power: 55)]),
        (id: "pha_thach_quyen", ap: 2, ll: 10, target: Enemy, melee: true, element: Tho, chargeable: true,
         effects: [Damage(power: 220)],
         charge_bonus: [(stage: 2, effects: [Status(id: PhaGiap, turns: 2)])]),
        (id: "nghich_menh_chi", ap: 3, ll: 18, target: Enemy, melee: true, chargeable: true, delay: 200,
