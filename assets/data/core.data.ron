        (id: "hon_dang", tier: 2, element: Hoa, active: Some("hon_dang_phe_anh")),
        (id: "truy_phong_ngoa", tier: 1, active: Some("truy_phong_bo"), passives: [SpeedBonus(5)]),
        (id: "bach_thao_dinh", tier: 3, element: Moc, active: Some("bach_thao_luyen")),
        (id: "pha_son_an", tier: 3, element: Tho, active: Some("pha_son_tran")),
        (id: "chieu_hon_phien", tier: 3, element: Hoa, active: Some("chieu_hon_trieu")),
    ],

    summons: [
        // Chiêu Hồn Phiên: a wronged soul that draws every single-target blow for two turns.
        (id: "oan_hon_ve", sheet: 8, tint: Some((0.55, 0.75, 1.0)), hp_pct: 45, def_pct: 120,
         turns: 2, taunt: true),
    ],

    formations: [
        (id: "ho_tam_tran", min_members: 1, phases: [
            (threshold: 2, aura: [WardEachActivation]),
            (threshold: 4, pulse: [ShieldAllPct(15)]),
            (threshold: 6, pulse: [CleanseAll, ShieldAllPct(30)]),
        ], release: [ShieldAllPct(10)]),
        (id: "tam_tai_kiem_tran", min_members: 3, phases: [
            (threshold: 3, aura: [AtkPct(15)]),
            (threshold: 6, pulse: [StrikeAll(60)]),
            (threshold: 9, pulse: [StrikeAll(60), StrikeAll(60), StrikeAll(60)]),
        ], release: [StrikeAll(80)]),
        (id: "ngu_hanh_tran", min_members: 2, elements_required: 2, phases: [
            (threshold: 3, aura: [LlRegen(4), ComboEnergy(1)]),
            (threshold: 6, pulse: [RestoreLlAllPct(20)]),
        ], release: [RestoreLlAllPct(40)]),
        (id: "pha_linh_tran", min_members: 2, phases: [
            (threshold: 3, aura: [AtkPct(10)]),
            (threshold: 6, pulse: [InterruptAllEnemies]),
        ], release: [StatusAllEnemies(PhaGiap, 2), StatusAllEnemies(PhongAn, 1)]),
        // Swap & tempo: free swaps, then both nodes hasted; release pulls them to act next.
        (id: "luong_nghi_tran", min_members: 2, phases: [
            (threshold: 2, aura: [FreeSwap]),
            (threshold: 4, pulse: [HasteAll(200)]),
        ], release: [HasteAll(900)]),
        // Illusion: decoys for the back row, then a slowing maze; release hides everyone.
        (id: "cuu_cung_me_tran", min_members: 3, phases: [
            (threshold: 4, pulse: [StatusRow(Back, HuAnh, 0)]),
            (threshold: 8, pulse: [StatusAllEnemies(Cham, 2)]),
        ], release: [StatusAllAllies(HuAnh, 0), DelayAllEnemies(200)]),
    ],

    characters: [
        // The protagonist; the sheet comes from the player's choice.
        (id: "player", sheet: 1, element: Tho, nghich_menh: true,
         base: (hp: 84, ll: 20, atk: 10, spi: 4, def: 5, tp: 32),
         growth: (hp: 38, ll: 22, atk: 6, spi: 3, def: 3, tp: 6),
         skills: ["quet_gay"], artifacts: []),
        // Guest in the night raid: his formation shields the hero.
        (id: "ong_mac", sheet: 10, element: Moc,
         base: (hp: 230, ll: 90, atk: 12, spi: 26, def: 14, tp: 34),
         skills: ["thanh_moc_cham", "duong_sinh_quyet"], artifacts: ["huyen_quy_thuan"]),
        // Companions from Chapter 2 on (story-bible §4.4–4.7). Not in the party yet.
        (id: "diep_han_suong", sheet: 3, element: Kim,
