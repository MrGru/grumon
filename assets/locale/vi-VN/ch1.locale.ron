    "skill.da_tru_can.name": "Táp",
    "skill.da_tru_can.desc": "Ngoạm bằng cặp nanh vàng khè.",
    "skill.da_tru_huc.name": "Húc",
    "skill.da_tru_huc.desc": "Chúi đầu lấy đà rồi lao tới, sức húc gãy cả hàng rào.",
    "skill.hac_y_chem.name": "Chém",
    "skill.hac_y_chem.desc": "Một nhát đao vụng về nhưng tàn nhẫn.",
    "skill.hac_y_dam_lien.name": "Đâm Liên Hoàn",
    "skill.hac_y_dam_lien.desc": "Hai nhát đâm nhanh vào kẻ yếu nhất.",
    "skill.huyet_ho_trao.name": "Huyết Hổ Trảo",
    "skill.huyet_ho_trao.desc": "Móng sắt rạch thịt, mang theo hỏa khí.",
    "skill.pha_tran_quyen.name": "Phá Trận Quyền",
    "skill.pha_tran_quyen.desc": "Một quyền nhắm vào trận nhãn, đánh vỡ thế trận.",
    "skill.huyet_sat_tram.name": "Huyết Sát Trảm",
    "skill.huyet_sat_tram.desc": "Gom huyết khí rất lâu rồi bổ xuống một đòn chí mạng.",
    "skill.ho_gam.name": "Hổ Gầm",
    "skill.ho_gam.desc": "Tiếng gầm chấn động, đánh trúng tất cả.",
    "skill.lang_can.name": "Cắn",
    "skill.lang_can.desc": "Lao tới cắn kẻ yếu nhất.",
    "skill.lang_dau_can_xe.name": "Cắn Xé",
    "skill.lang_dau_can_xe.desc": "Rình một nhịp rồi cắn xé dữ dội.",
    "skill.lang_nha_trao.name": "Lang Trảo",
    "skill.lang_nha_trao.desc": "Móng vuốt bọc thép cào ngang.",
    "skill.lang_nha_phi_tieu.name": "Phi Tiêu Tẩm Độc",
    "skill.lang_nha_phi_tieu.desc": "Phóng phi tiêu ngắt ngang kẻ đang Tụ khí, kèm độc.",
    "skill.lang_nha_hu.name": "Hú Gọi Bầy",
    "skill.lang_nha_hu.desc": "Tiếng hú thúc đồng bọn hành động sớm hơn.",
    "skill.lang_nha_cuong_hoa.name": "Lang Huyết Cuồng Hóa",
    "skill.lang_nha_cuong_hoa.desc": "Khi bị thương nặng, uống máu sói hóa cuồng: Cường công 3 lượt và hồi chút khí huyết.",

    // ---------------------------------------------------------------- Trận đấu
    "encounter.ch1_da_tru.objective": "Đánh bại Dã Trư",
    "encounter.ch1_hac_y.objective": "Đánh bại tên áo đen chặn đường",
    "encounter.ch1_dem_mua.objective": "Giữ vững đến khi Hộ Tâm Trận đạt tầng 3",
    "encounter.ch1_lang_dem.objective": "Đánh bại bầy sói",
    "encounter.ch1_lang_nha.objective": "Đánh bại Lang Nha",

    "hint.ch1_da_tru.1": "Dải trên cùng là Thứ tự hành động. Ai có Thân pháp cao sẽ đến lượt thường xuyên hơn.",
    "hint.ch1_da_tru.2": "Mỗi lượt bạn có 3 Điểm hành động (ĐHĐ). Đánh thường tốn 1 ĐHĐ. Dư ĐHĐ khi kết thúc lượt sẽ được giữ lại 1.",
    "hint.ch1_da_tru.3": "Khi kẻ địch “niệm” một đòn mạnh, nó hiện màu đỏ trên Thứ tự hành động. Hãy Thủ thế để chỉ chịu một nửa sát thương.",
    "hint.ch1_hac_y.1": "Vật phẩm dùng trong trận tốn 1 ĐHĐ. Sỏi Ném gây chút sát thương và đẩy lùi lượt của kẻ địch.",
    "hint.ch1_dem_mua.1": "Không thể đánh bại Đồ Cuồng. Mục tiêu là đưa Hộ Tâm Trận lên tầng 3: mỗi lượt của bạn và ông Mạc đều nạp thêm trận lực.",
    "hint.ch1_dem_mua.2": "Huyền Quy Thuẫn của ông Mạc tạo khiên. Sát thương bị khiên chặn sẽ hóa thành trận lực — hãy che cho người sắp hứng Huyết Sát Trảm.",
    "hint.ch1_dem_mua.3": "Phá Trận Quyền đánh vỡ trận nhãn. Người bị vỡ trận nhãn hãy chọn Trận pháp › Ổn trận để vá lại.",
    "hint.ch1_lang_dem.1": "Linh Lang nhanh hơn bạn nhiều. Đừng đọ tốc độ: Sỏi Ném đẩy lùi một con, Khói Mê Hương đẩy lùi cả bầy.",
    "hint.ch1_lang_dem.2": "Quét Gậy đánh trúng mọi kẻ địch. Lang Đầu sẽ niệm Cắn Xé — đẩy lùi nó hoặc Thủ thế đúng lúc.",
    "hint.ch1_lang_nha.1": "Tụ khí tích một bậc mỗi lượt. Phá Thạch Quyền tiêu hết Tụ khí để nhân sát thương; từ bậc 2 còn gây Phá giáp.",
    "hint.ch1_lang_nha.2": "Lang Nha phóng phi tiêu ngắt bất cứ ai Tụ khí từ bậc 2 (xem dòng Phản ứng dưới thẻ của hắn). Tụ bậc 1 cuối lượt này, lượt sau Tụ lên bậc 2 rồi tung Phá Thạch Quyền ngay — hắn sẽ không kịp ngắt.",
    "hint.ch1_lang_nha.3": "Tụ Linh Hồ Lô cất giữ Linh lực thừa. Dùng nó để tích thêm một bậc Tụ khí ngay trong lượt. Giữ lại 1 ĐHĐ từ lượt trước để có 4 ĐHĐ: Phóng Linh, Tụ khí rồi Phá Thạch Quyền liền một mạch.",
    "hint.ch1_lang_nha.4": "Khi còn dưới một nửa khí huyết, Lang Nha sẽ hóa cuồng. Hãy dồn đòn mạnh để kết thúc nhanh.",

    // ---------------------------------------------------------------- Nhiệm vụ
    "quest.ch1_hai_thuoc.title": "Hái Thanh Tâm Thảo",
    "quest.ch1_hai_thuoc.desc": "Bệnh ho của bà Tư đầu xóm lại tái. Ông Mạc cần ba nhánh Thanh Tâm Thảo mọc dưới bóng thông ở Rừng Tây.",
    "quest.ch1_hai_thuoc.obj.gather": "Hái 3 nhánh Thanh Tâm Thảo ở Rừng Tây (phía tây làng)",
    "quest.ch1_hai_thuoc.obj.return": "Mang thuốc về cho ông Mạc",
    "quest.ch1_le_hoi.title": "Lễ Cúng Thần Sông",
    "quest.ch1_le_hoi.desc": "Năm nào Liên và {playerName} cũng cùng nhau thả đèn hoa đăng. Năm nay có lẽ là lần cuối trước khi Liên lên núi.",
    "quest.ch1_le_hoi.obj.meet": "Gặp Liên ở Bến Thanh Khê (phía nam làng) lúc hoàng hôn",
    "quest.ch1_huyet_kiep.title": "Huyết Kiếp",
    "quest.ch1_huyet_kiep.desc": "Thanh Khê bốc cháy giữa đêm mưa. Những kẻ áo đen đang tàn sát dân làng.",
    "quest.ch1_huyet_kiep.obj.enter": "Trở về làng",
    "quest.ch1_huyet_kiep.obj.find": "Tìm ông Mạc ở nhà phía bắc làng",
    "quest.ch1_chay_tron.title": "Chạy trốn",
    "quest.ch1_chay_tron.desc": "Ông Mạc dặn chạy về phía tây, qua rừng, lên Hàn Phong Lĩnh tìm Miếu Sơn Thần.",
    "quest.ch1_chay_tron.obj.forest": "Thoát khỏi Rừng Tây",
    "quest.ch1_chay_tron.obj.shrine": "Tìm Miếu Sơn Thần trên Hàn Phong Lĩnh (phía bắc rừng)",
    "quest.ch1_chay_tron.obj.survive": "Sống sót",
    "quest.ch1_binh_minh.title": "Tro tàn và bình minh",
    "quest.ch1_binh_minh.desc": "Đêm đã qua. Người chết cần được chôn cất, và kẻ sống cần một câu trả lời.",
    "quest.ch1_binh_minh.obj.bury": "Lo hậu sự cho ông Mạc",
    "quest.ch1_binh_minh.obj.token": "Tìm manh mối trong sân nhà",
    "quest.ch1_binh_minh.obj.farewell": "Từ biệt trưởng thôn",
    "quest.ch1_dieu.title": "Con diều của bé Đậu",
    "quest.ch1_dieu.desc": "Con diều vẽ rồng của bé Đậu mắc trên ngọn dừa ngoài bến sông.",
    "quest.ch1_dieu.obj.find": "Gỡ con diều trên cây dừa ở Bến Thanh Khê",
    "quest.ch1_dieu.obj.return": "Trả diều cho bé Đậu",
    "quest.ch1_chao_ca.title": "Nồi cháo cá của thím Ba",
    "quest.ch1_chao_ca.desc": "Nồi cháo cúng Thần Sông mà thiếu cá thì thím Ba không chịu nổi.",
    "quest.ch1_chao_ca.obj.fish": "Xin chú Năm Chài một con cá suối ở bến",
    "quest.ch1_chao_ca.obj.return": "Mang cá về cho thím Ba",
    "quest.ch1_tram_go.title": "Trâm gỗ hoa sen",
    "quest.ch1_tram_go.desc": "Cây trâm gỗ của Liên đã gãy. Một cây trâm mới khắc từ gỗ đào có lẽ sẽ làm cô vui.",
    "quest.ch1_tram_go.obj.wood": "Nhặt gỗ đào trôi dạt ở Bến Thanh Khê",
    "quest.ch1_tram_go.obj.knife": "Mượn dao khắc của chú Sơn",
    "quest.ch1_tram_go.obj.carve": "Khắc trâm ở bàn gỗ nhà ông Mạc",

    // ---------------------------------------------------------------- Mở đầu
    "dlg.ch1_prologue.start": "…",
    "dlg.ch1_prologue.n2": "Ngươi… nghe thấy ta không?",
    "dlg.ch1_prologue.n3": "Một tia sáng xanh biếc, như ngọc vỡ, lóe lên giữa bóng tối mênh mông.",
    "dlg.ch1_prologue.n4": "Còn chưa… Chưa phải lúc. Khi trời đổ máu, ta sẽ tìm ngươi.",
    "dlg.ch1_prologue.n5": "Tiếng gõ cửa cộc cộc kéo {playerName} ra khỏi giấc mơ.",

    "dlg.ch1_ong_mac_morning.start": "{playerName}! Mặt trời lên quá ngọn tre rồi mà {g:thằng nhóc|con bé|đứa nhỏ} này còn nằm ỳ ra đấy à?",
    "dlg.ch1_ong_mac_morning.p2": "Con dậy rồi, dậy rồi đây ông… Con lại mơ thấy cái giấc mơ kỳ lạ ấy.",
    "dlg.ch1_ong_mac_morning.p3": "Mơ với chả mộng. Nghe đây: bệnh ho của bà Tư đầu xóm lại tái, ông cần ba nhánh Thanh Tâm Thảo.",
    "dlg.ch1_ong_mac_morning.p4": "Thứ cỏ lá xanh lam ấy mọc dưới bóng thông ở Rừng Tây. Cứ theo lối mòn phía tây làng mà đi.",
    "dlg.ch1_ong_mac_morning.p5": "Giấc mơ đêm qua vẫn còn lởn vởn trong đầu {playerName}.",
    "dlg.ch1_ong_mac_morning.p5.ask_dream": "Ông ơi, có khi nào giấc mơ là điềm báo không?",
    "dlg.ch1_ong_mac_morning.p5.go": "Con đi ngay đây.",
    "dlg.ch1_ong_mac_morning.d1": "Ông Mạc khựng lại một thoáng. Chén trà trên tay ông khẽ rung.",
    "dlg.ch1_ong_mac_morning.d2": "Người già hay bảo: mơ thấy ngọc là gặp quý nhân, mơ thấy máu là gặp tai họa. Còn ông thì bảo: mơ thấy ông là phải đi làm.",
    "dlg.ch1_ong_mac_morning.p6": "Nhớ về trước hoàng hôn. Dạo này sói rừng hay mò xuống tận bìa làng.",
    "dlg.ch1_ong_mac_morning.p7": "À, chiều nay có lễ Cúng Thần Sông. Con bé nhà lão Sơn chắc đang đợi con đấy.",

    "dlg.ch1_ong_mac_waiting.start": "Thanh Tâm Thảo lá xanh lam, mọc dưới gốc thông. Đủ ba nhánh thì mang về cho ông.",
    "dlg.ch1_ong_mac_waiting.n2": "Rừng Tây ở phía tây làng. Mặt trời còn cao, nhưng đừng có la cà.",

    "dlg.ch1_ong_mac_herbs.start": "Ồ, về rồi đấy à. Để ông xem nào… Lá còn sương, rễ không dập. Khá lắm.",
    "dlg.ch1_ong_mac_herbs.h2": "Ông ơi… người như con, không có linh căn, thì sau này làm được gì?",
    "dlg.ch1_ong_mac_herbs.h3": "Ai bảo con thế? Đứa nào đo linh căn cho con?",
    "dlg.ch1_ong_mac_herbs.h4": "Thì… tháng trước người của Thanh Huyền Môn xuống làng đo cho cả lũ trẻ. Đá sáng với Liên, sáng với cả thằng Tí. Với con thì chẳng có gì.",
    "dlg.ch1_ong_mac_herbs.h5": "Đá là đá. Người là người.",
    "dlg.ch1_ong_mac_herbs.h6": "Có linh căn hay không, con vẫn là con. Ông chưa từng cần một đứa cháu biết bay.",
    "dlg.ch1_ong_mac_herbs.h7": "Ông Mạc cúi xuống phân thuốc, như thể câu chuyện chẳng có gì to tát.",
    "dlg.ch1_ong_mac_herbs.h7.thanks": "Con cảm ơn ông.",
    "dlg.ch1_ong_mac_herbs.h7.doubt": "Nhưng lỡ một ngày ông không còn nữa thì sao?",
    "dlg.ch1_ong_mac_herbs.t1": "Cảm ơn cái gì. Cầm lấy, ông cho ít tiền ra lễ mua bánh.",
    "dlg.ch1_ong_mac_herbs.d1": "Thì con sống tiếp. Sống cho đàng hoàng, thế là đủ.",
    "dlg.ch1_ong_mac_herbs.d2": "Ông Mạc nhìn ra cửa sổ, về phía dãy núi phương bắc, rất lâu.",
    "dlg.ch1_ong_mac_herbs.recipe": "À, còn cái này. Thừa cỏ Thanh Tâm với nanh lợn rừng thì đem ra bếp thuốc trước nhà mà sắc thành thuốc trị thương. Lửa liu riu thôi, nóng vội là hỏng cả nồi.",
    "dlg.ch1_ong_mac_herbs.end": "Trời ngả chiều rồi. Ra bến đi, lễ sắp bắt đầu. Ông ở nhà sắc thuốc cho bà Tư.",

    "dlg.ch1_ong_mac_dusk.start": "Còn đứng đây làm gì? Ra bến đi, con bé Liên đợi đấy.",
    "dlg.ch1_ong_mac_idle.start": "Ông đang bận phân thuốc. Có việc gì thì nói nhanh, không thì ra ngoài chơi.",

    // ---------------------------------------------------------------- Liên
    "dlg.ch1_lien_morning.start": "{playerName}! Cậu dậy muộn thế? Tớ đợi từ lúc gà gáy đến giờ đấy.",
    "dlg.ch1_lien_morning.l2": "Ông bắt tớ đi hái thuốc. Cậu đợi tớ làm gì?",
    "dlg.ch1_lien_morning.l3": "Thì… mùa xuân này tớ phải lên Thanh Huyền Môn rồi. Họ bảo song linh căn Thủy Mộc hiếm lắm.",
    "dlg.ch1_lien_morning.l4": "Mẹ tớ khóc cả đêm. Cha tớ thì chẳng nói gì, chỉ ngồi mài dao đến sáng.",
    "dlg.ch1_lien_morning.l5": "Liên nhìn {playerName}, chờ đợi.",
    "dlg.ch1_lien_morning.l5.happy": "Chúc mừng cậu! Sau này thành tiên nhớ bay về thăm làng.",
    "dlg.ch1_lien_morning.l5.quiet": "…Vậy là cậu sắp đi thật à?",
    "dlg.ch1_lien_morning.h1": "Thành tiên gì chứ. Tớ chỉ sợ trên ấy không có suối để bơi.",
    "dlg.ch1_lien_morning.q1": "Ừ. Nhưng còn những ba tháng nữa cơ mà. Đừng làm cái mặt như đưa đám thế.",
    "dlg.ch1_lien_morning.l6": "Chiều nay ra bến thả đèn với tớ nhé. Năm nào hai đứa mình cũng đi, năm nay không được bỏ.",

    "dlg.ch1_lien_again.hairpin": "Hôm qua tớ làm gãy cây trâm gỗ mẹ cho rồi. Tóc cứ xõa ra, vướng víu chết đi được.",
    "dlg.ch1_lien_again.h2": "Liên vén mớ tóc còn ướt ra sau tai, cười như chẳng có chuyện gì.",
    "dlg.ch1_lien_again.h3": "Một ý nghĩ chợt lóe lên.",
    "dlg.ch1_lien_again.h3.carve": "(Mình sẽ khắc tặng cậu ấy một cây trâm mới.)",
    "dlg.ch1_lien_again.h3.skip": "(Để sau vậy.)",
    "dlg.ch1_lien_again.c1": "Gỗ đào trôi dạt ở bến sông vừa thơm vừa bền. Mượn dao khắc của chú Sơn là làm được.",
    "dlg.ch1_lien_again.remind": "Chiều nhớ ra bến đấy. Cậu mà quên là tớ dìm xuống suối.",
    "dlg.ch1_lien_hairpin_hint.start": "Cậu giấu gì sau lưng thế? …Thôi, tớ không hỏi nữa. Chiều gặp ở bến nhé!",

    // ---------------------------------------------------------------- Dân làng
    "dlg.ch1_son_knife.start": "Hử? Mượn dao khắc à.",
    "dlg.ch1_son_knife.s2": "…Định khắc gì cho con Liên chứ gì. Đừng có chối.",
    "dlg.ch1_son_knife.s3": "Cầm lấy. Lưỡi bén, cẩn thận kẻo đứt tay. Gỗ đào thì ra bến mà nhặt.",
    "dlg.ch1_son_idle.start": "…",
    "dlg.ch1_son_idle.s2": "Con Liên sắp lên núi. Chú đang rèn cho nó con dao găm, đi đâu cũng phải có thứ phòng thân.",
    "dlg.ch1_son_idle.s3": "Cháu là bạn nó từ bé. Nếu có ngày nó gặp chuyện… cháu đừng bỏ nó lại.",

    "dlg.ch1_ly_duc_day.start": "À, cháu nhà ông Mạc. Chiều nay lễ Cúng Thần Sông, nhớ mang theo đèn.",
    "dlg.ch1_ly_duc_day.n2": "Mà này… hôm qua có mấy người lạ áo đen ghé quán thím Ba. Họ hỏi đường lên núi phía bắc, hỏi cả nhà ông Mạc.",
    "dlg.ch1_ly_duc_day.n3": "Trưởng thôn vuốt chòm râu bạc, vẻ mặt đầy lo âu.",
    "dlg.ch1_ly_duc_day.n3.ask": "Họ hỏi ông Mạc làm gì ạ?",
    "dlg.ch1_ly_duc_day.n3.ok": "Chắc là người đi buôn thuốc thôi ông.",
    "dlg.ch1_ly_duc_day.a1": "Ta cũng không rõ. Ta bảo ông Mạc chỉ là thầy lang quê, ai muốn chữa bệnh thì cứ đến.",
    "dlg.ch1_ly_duc_day.a2": "Bọn họ cười. Cái kiểu cười ấy… ta không ưa chút nào.",
    "dlg.ch1_ly_duc_day.o1": "Mong là thế. Thời buổi này, tiên nhân với yêu ma nhiều khi chẳng khác gì nhau.",

    "dlg.ch1_dau_morning.start": "{g:Anh |Chị |}{playerName}! Hu hu… diều của em mắc trên ngọn cây dừa ngoài bến rồi!",
    "dlg.ch1_dau_morning.d2": "Em leo không tới. Diều ấy em vẽ con rồng, đẹp nhất xóm đấy!",
    "dlg.ch1_dau_morning.d3": "Bé Đậu sụt sịt, mắt đỏ hoe.",
    "dlg.ch1_dau_morning.d3.help": "Để {g:anh|chị|mình} lấy giúp cho.",
    "dlg.ch1_dau_morning.d3.later": "Lát nữa nhé, {g:anh|chị|mình} đang bận.",
    "dlg.ch1_dau_morning.h1": "Thật ạ? {g:Anh|Chị|Bạn} đúng là đại hiệp! Em sẽ cho cả túi sỏi ném chim của em!",
    "dlg.ch1_dau_morning.l1": "Vâng… nhưng nhớ đấy nhé! Ngoéo tay rồi đấy!",
    "dlg.ch1_dau_kite_wait.start": "Diều của em mắc trên cây dừa ngoài bến ấy. Cây dừa gần chỗ lão Hà đậu đò.",
    "dlg.ch1_dau_kite_return.start": "A! Diều rồng của em! {g:Anh |Chị |}{playerName} giỏi quá!",
    "dlg.ch1_dau_kite_return.r2": "Đây, sỏi ném chim của em. Lão Mộc thợ săn bảo ném trúng mũi thì sói cũng phải khựng lại đấy!",
    "dlg.ch1_dau_after.start": "Lớn lên em sẽ làm kiếm khách như trong truyện! Bay vèo vèo trên mái nhà!",

    "dlg.ch1_thim_ba_morning.start": "Ơ kìa, {g:thằng quỷ nhỏ|con quỷ nhỏ|đứa quỷ nhỏ} nhà ông Mạc! Lại đây thím nhờ tí.",
    "dlg.ch1_thim_ba_morning.t2": "Nồi cháo cá cúng Thần Sông chiều nay mà thiếu cá thì thần giận, thần giận thì thím cạo đầu cả xóm!",
    "dlg.ch1_thim_ba_morning.t3": "Ra bến xin chú Năm Chài một con cá suối giúp thím nhé. Bảo là thím Ba dặn, lão không dám lấy tiền đâu.",
    "dlg.ch1_thim_ba_fish_wait.start": "Cá đâu? Chưa có cá thì đừng về. À mà về thì cũng được, nhưng phải có cá!",
    "dlg.ch1_thim_ba_fish_return.start": "Ôi con cá béo chưa kìa! Ngoan, ngoan lắm.",
    "dlg.ch1_thim_ba_fish_return.f2": "Cầm lấy mấy cái bánh đậu xanh, với gói hương mê này. Hồi trẻ thím đi rừng, đốt nó lên là thú dữ cũng ngủ gật.",
    "dlg.ch1_thim_ba_after.start": "Chiều ra bến nhớ ghé ăn bát cháo. Thím để phần cho bát to nhất.",
    "dlg.ch1_thim_ba_after.ask": "Mà có mua gì không? Bánh đậu xanh thím mới hấp, còn nóng hổi.",
    "dlg.ch1_thim_ba_after.ask.buy": "Cho con xem hàng.",
    "dlg.ch1_thim_ba_after.ask.bye": "Dạ thôi, con đi đây.",
    "dlg.ch1_thim_ba_fish_wait.ask": "Tiện thể mua gì thì mua luôn đi, thím đang bận tối mắt.",
    "dlg.ch1_thim_ba_fish_wait.ask.buy": "Cho con xem hàng.",
    "dlg.ch1_thim_ba_fish_wait.ask.bye": "Dạ thôi, con đi lấy cá đây.",
    "shop.ch1_quan_thim_ba.name": "Quán thím Ba",

    "dlg.ch1_nam_fish.start": "Thím Ba sai đi xin cá hả? Hà hà, bà ấy mà dặn thì ai dám không cho.",
    "dlg.ch1_nam_fish.n2": "Đây, con cá chép suối béo nhất sáng nay. Bảo bà ấy bớt mắng tôi đi nhé.",
    "dlg.ch1_nam_idle.start": "Mấy hôm nay cá lặn sâu lắm. Nước sông tự dưng lạnh buốt, như có ai ném đá xuống tận đáy.",
    "dlg.ch1_nam_idle.n2": "Chắc tại sắp đổi mùa thôi. Chắc thế.",

    "dlg.ch1_lao_ha.start": "Chèo đò bốn mươi năm, ta thấy tiên nhân bay qua sông đúng ba lần.",
    "dlg.ch1_lao_ha.n2": "Lần nào họ cũng chẳng ngoảnh lại. Với họ, người phàm như bọn ta chắc chỉ là con kiến bên bờ.",
    "dlg.ch1_lao_ha.n3": "Lão Hà gõ tẩu thuốc vào mạn đò, ánh mắt xa xăm.",
    "dlg.ch1_lao_ha.n3.ask": "Tiên nhân bay đi đâu vậy ông?",
    "dlg.ch1_lao_ha.n3.leave": "Cháu chào ông.",
    "dlg.ch1_lao_ha.a1": "Về phía bắc, phía Thanh Huyền Sơn. Xa hơn nữa là Thiên Trụ, nghe nói đỉnh núi chạm tới tận trời.",
    "dlg.ch1_lao_ha.a2": "Người ta bảo ai lên được đỉnh ấy sẽ phi thăng, sống mãi không già. Ta thì chỉ mong sống đủ để chèo thêm một mùa nước nữa.",

    "dlg.ch1_vo_trang_gift.start": "Ê, cháu nhà ông Mạc! Lại đi hái thuốc à?",
    "dlg.ch1_vo_trang_gift.g2": "Cẩn thận con lợn rừng ở khoảng rừng phía trước, nó húc gãy cả rào nhà lão Mộc đấy.",
    "dlg.ch1_vo_trang_gift.g3": "Thấy nó chúi đầu lấy đà thì đứng vững mà đỡ, đừng có chạy. Cầm mấy hòn sỏi này, ném trúng mũi là nó khựng ngay.",
    "dlg.ch1_vo_trang_idle.start": "Sáng nay ta thấy dấu giày lạ ở đường mòn. Giày vải đen, đế mỏng, chẳng phải giày người đi rừng.",
    "dlg.ch1_vo_trang_idle.i2": "Thôi, chắc khách buôn lạc đường. Cháu về trước khi trời tối nhé.",

    "dlg.ch1_hoang_khai.start": "Tại hạ Hoàng Khải, thư sinh du ngoạn Cửu Vực, đang chép lại phong tục các vùng.",
    "dlg.ch1_hoang_khai.ask": "Đạo hữu nhỏ tuổi muốn hỏi điều gì?",
    "dlg.ch1_hoang_khai.ask.vuc": "Cửu Vực là gì vậy?",
    "dlg.ch1_hoang_khai.ask.tong_mon": "Ông biết gì về Thanh Huyền Môn không?",
    "dlg.ch1_hoang_khai.ask.bye": "Cháu xin phép.",
    "dlg.ch1_hoang_khai.v1": "Thiên hạ chia làm chín vực, bao quanh Thiên Trụ. Nơi này là Đông Lâm Vực, rừng núi trùng điệp, người hiền như đất.",
    "dlg.ch1_hoang_khai.v2": "Đi về phía tây là sa mạc Tây Hoang, phía bắc là thảo nguyên Bắc Mạc của ma đạo. Mỗi vực một trời, mỗi trời một luật.",
    "dlg.ch1_hoang_khai.t1": "Một tông môn chính đạo hạng trung. Năm nào cũng xuống các thôn đo linh căn, chọn trẻ có tư chất mang về.",
    "dlg.ch1_hoang_khai.t2": "Có điều… tại hạ để ý, những đứa trẻ được chọn hiếm khi về thăm nhà. Có lẽ tu tiên thì phải đoạn tuyệt trần duyên.",

    "dlg.ch1_tinh_an.start": "Vô Lượng Thiên Tôn. Thí chủ lên tận Hàn Phong Lĩnh làm gì giữa trời giá rét thế này?",
    "dlg.ch1_tinh_an.n2": "Miếu Sơn Thần kia đã bỏ hoang trăm năm. Người ta nói Sơn Thần giữ một lời thề với ai đó, rồi cứ thế ngủ quên.",
    "dlg.ch1_tinh_an.n3": "Bần đạo chỉ đến quét lá, thắp nén hương. Đêm xuống, gió núi lạnh như dao, thí chủ nên về sớm.",

    "dlg.ch1_lao_moc.start": "Đi săn ba mươi năm mà chưa thấy mùa nào sói xuống núi nhiều như năm nay.",
    "dlg.ch1_lao_moc.n2": "Mắt chúng nó đỏ quạch, nhanh như gió. Ta dặn cháu: sói nhanh thì đừng đọ nhanh với nó, hãy làm nó chậm lại.",
    "dlg.ch1_lao_moc.n3": "Một hòn sỏi trúng mũi, một nắm hương mê… sói nào cũng phải chùn bước. Nhớ lấy.",

    // ---------------------------------------------------------------- Rừng Tây, ban ngày
    "dlg.ch1_footprints.start": "Trên nền đất ẩm có những dấu giày lạ: đế mỏng, mũi nhọn, in sâu như người mang vật nặng.",
    "dlg.ch1_footprints.f2": "Giày vải đen… Người trong thôn đi rừng toàn đi dép cỏ. Ai vào rừng giờ này nhỉ?",
    "dlg.ch1_footprints.f3": "Dấu chân dẫn về phía bắc, về phía Hàn Phong Lĩnh.",
    "dlg.ch1_da_tru_intro.start": "Bụi rậm rung lên. Một con lợn rừng to như cái cối đá lao ra, nanh trắng nhởn.",
    "dlg.ch1_da_tru_intro.n2": "Ối! Con lợn rừng anh Tráng nói đây rồi!",
    "dlg.ch1_da_tru_after.start": "Phù… Nếu không đỡ đúng lúc thì giờ mình đã nằm dưới gốc thông rồi.",

    // ---------------------------------------------------------------- Bến sông, việc vặt
    "dlg.ch1_kite_found.start": "Con diều vẽ hình rồng mắc trên tàu lá dừa. {playerName} kiễng chân, gỡ được sợi dây.",
    "dlg.ch1_ban_go.carve": "{playerName} ngồi xuống bên bàn gỗ của ông Mạc. Từng nhát dao nhỏ, mùi gỗ đào thơm ngai ngái.",
    "dlg.ch1_ban_go.c2": "Khi mặt trời nghiêng bóng, một cây trâm hình hoa sen nằm gọn trong lòng bàn tay.",
    "dlg.ch1_ban_go.look": "Bàn gỗ ông Mạc dùng để thái thuốc. Mùi cam thảo và trần bì còn vương trên mặt gỗ.",

    // ---------------------------------------------------------------- Hoàng hôn
    "dlg.ch1_lien_dusk.start": "Cậu đến rồi! Tớ cứ tưởng cậu lại bị ông Mạc bắt ngồi sắc thuốc.",
    "dlg.ch1_lien_dusk.ready": "Xong hết việc chưa? Thả đèn xong là tối mịt đấy, không kịp làm gì nữa đâu.",
    "dlg.ch1_lien_dusk.ready.go": "Xong rồi, mình thả đèn thôi. (Không thể quay lại làm việc dang dở.)",
    "dlg.ch1_lien_dusk.ready.wait": "Đợi tớ một lát.",
    "dlg.ch1_lien_dusk.w1": "Nhanh lên nhé, đèn của tớ sắp tự bay mất rồi đây.",
    "dlg.ch1_lien_dusk.f1": "Hoàng hôn nhuộm đỏ mặt sông. Hàng trăm chiếc đèn hoa đăng trôi chầm chậm, như một dòng sao nhỏ.",
    "dlg.ch1_lien_dusk.f2": "Năm nào tớ cũng ước cùng một điều. Năm nay tớ đổi rồi.",
    "dlg.ch1_lien_dusk.f3": "Cậu ước gì?",
    "dlg.ch1_lien_dusk.f4": "Nói ra thì mất thiêng. …Thôi được, tớ ước sau này dù ở đâu, hai đứa mình vẫn tìm được nhau.",
    "dlg.ch1_lien_dusk.f5": "Ngọn đèn của Liên trôi xa dần, chập chờn giữa sóng.",
    "dlg.ch1_lien_dusk.f5.promise": "Tớ hứa sẽ lên núi thăm cậu. Dù có phải trèo đến gãy chân.",
    "dlg.ch1_lien_dusk.f5.truth": "Thật ra… tớ sợ. Sợ cậu đi rồi sẽ quên cái làng nhỏ này, quên cả tớ.",
    "dlg.ch1_lien_dusk.p1": "Hứa rồi đấy nhé! Ngoéo tay. Ai nuốt lời thì làm con cá trê suốt đời!",
    "dlg.ch1_lien_dusk.t1": "Đồ ngốc.",
    "dlg.ch1_lien_dusk.t2": "Liên khẽ tựa vai vào {playerName}, nhìn theo chiếc đèn của mình.",
    "dlg.ch1_lien_dusk.t3": "Có những thứ người ta không bao giờ quên được. Cậu là một trong số đó.",
    "dlg.ch1_lien_dusk.gift": "Cây trâm gỗ hoa sen vẫn nằm trong túi áo.",
    "dlg.ch1_lien_dusk.gift.give": "(Đưa cây trâm gỗ hoa sen cho Liên.)",
    "dlg.ch1_lien_dusk.gift.keep": "(Để dịp khác.)",
    "dlg.ch1_lien_dusk.g1": "Đây là… cậu tự khắc à? Hoa sen gì mà méo xệch… xấu thật đấy.",
    "dlg.ch1_lien_dusk.g2": "Liên vừa cười vừa cài cây trâm lên tóc, mắt long lanh như mặt sông.",
    "dlg.ch1_lien_dusk.g3": "Tớ sẽ cài nó mãi. Lên núi rồi cũng cài.",
    "dlg.ch1_lien_dusk.sky": "Bỗng gió đổi chiều. Mây đen từ phương bắc ùn ùn kéo tới, nuốt chửng ráng chiều.",
    "dlg.ch1_lien_dusk.s2": "Những giọt mưa đầu tiên rơi xuống — nặng, lạnh, và đỏ như máu dưới ánh lửa phía làng.",
    "dlg.ch1_lien_dusk.s3": "Làng… làng mình cháy rồi! Cha tớ! Mẹ tớ!",
    "dlg.ch1_lien_dusk.s4": "Liên vùng chạy về phía làng. Tiếng chuông báo động vang lên, rồi tắt lịm giữa chừng.",
    "dlg.ch1_lien_dusk.s5": "Liên! Đợi đã! Ông ơi…!",
    "dlg.ch1_dusk_block.start": "Liên đang đợi ngoài bến. Lễ thả đèn sắp bắt đầu rồi.",

    // ---------------------------------------------------------------- Đêm thảm sát
    "dlg.ch1_raid_enter.start": "Thanh Khê chìm trong biển lửa. Mái tranh sụp xuống, khói đen cuộn lên trong màn mưa.",
    "dlg.ch1_raid_enter.r2": "Những bóng người áo đen lướt giữa ánh lửa, tay cầm đao còn nhỏ máu.",
    "dlg.ch1_raid_enter.r3": "Nhà ông Mạc ở phía bắc… Phải tìm ông!",
    "dlg.ch1_raid_block.start": "Không… Ông vẫn còn ở trong làng. Phải tìm ông trước đã!",
    "dlg.ch1_thim_ba_raid.start": "{playerName}! Trời ơi, con còn sống!",
    "dlg.ch1_thim_ba_raid.t2": "Bọn chúng… bọn chúng giết người như ngóe! Lão Sơn chặn cửa lò rèn cho vợ con chạy, rồi…",
    "dlg.ch1_thim_ba_raid.t3": "Thằng Đậu chạy lạc rồi, thím tìm mãi không thấy! Hình như nó trốn sau gốc cây phía tây!",
    "dlg.ch1_thim_ba_raid.t4": "Thím ra bến trốn. Con đi tìm ông con đi, nhanh lên!",
    "dlg.ch1_dau_raid.start": "Hức… hức… {g:anh |chị |}{playerName}…",
    "dlg.ch1_dau_raid.d2": "Bọn người áo đen… chúng bắt chị Liên đi rồi. Em sợ lắm…",
    "dlg.ch1_dau_raid.d3": "Tiếng binh khí từ phía nhà ông Mạc vọng tới qua màn mưa.",
    "dlg.ch1_dau_raid.d3.save": "(Cõng bé Đậu ra bến với thím Ba. Sẽ mất thêm thời gian.)",
    "dlg.ch1_dau_raid.d3.hide": "(Bảo bé trốn thật kỹ. Phải tìm ông ngay.)",
    "dlg.ch1_dau_raid.s1": "{playerName} cõng bé Đậu lao qua những mái nhà đang cháy, ra tận bờ sông nơi thím Ba đang nấp.",
    "dlg.ch1_dau_raid.s2": "Đậu! Ôi con tôi! Cảm ơn con… Đi đi, đi tìm ông con đi!",
    "dlg.ch1_dau_raid.s3": "Khi quay lại, tiếng binh khí từ phía nhà ông Mạc đã vang lên dữ dội.",
    "dlg.ch1_dau_raid.h1": "Đậu, nghe {g:anh|chị|mình} này: trốn yên ở đây, dù nghe thấy gì cũng đừng ra. {g:Anh|Chị|Mình} sẽ quay lại.",
    "dlg.ch1_dau_raid.h2": "Hứa… hứa nhé…",
    "dlg.ch1_hac_y_talk.start": "Còn sót một con chuột nhắt à? Lại đây, ông mày tiễn đi gặp cha mẹ.",
    "dlg.ch1_hac_y_talk.h2": "Tránh ra!",
    "dlg.ch1_hac_y_after.start": "Gã áo đen ngã vật xuống bùn. Trong tay hắn chỉ là một thanh đao rèn vụng — không phải tu sĩ, chỉ là kẻ đánh thuê.",
    "dlg.ch1_hac_y_after.a2": "Ông ơi… cố lên, con đến đây!",
    "dlg.ch1_do_cuong_taunt.start": "Một con kiến nữa. Đợi lão tử xử xong lão già này rồi sẽ đến lượt mày.",

    "dlg.ch1_raid_ong_mac.start": "Trước sân nhà, ông Mạc đứng giữa mưa, tay áo bạc phếch phần phật. Đối diện là một gã khổng lồ mặt đỏ, đôi móng sắt nhỏ máu.",
    "dlg.ch1_raid_ong_mac.r2": "Mạc Tùng! Mai danh ẩn tích mười bảy năm, giờ thì chui vào đâu nữa?",
    "dlg.ch1_raid_ong_mac.r3": "Đồ Cuồng của Vạn Hồn Điện… Kẻ đứng sau ngươi nuôi chó cũng chẳng kén chọn nhỉ.",
    "dlg.ch1_raid_ong_mac.r4": "Ông ơi!",
    "dlg.ch1_raid_ong_mac.r5": "{playerName}?! Sao con lại quay về đây…",
    "dlg.ch1_raid_ong_mac.r6": "…Thôi được. Đứng sau lưng ông. Dù có chuyện gì cũng đừng rời khỏi trận.",
    "dlg.ch1_raid_ong_mac.r7": "Ông Mạc rút ra một tấm khiên mai rùa đen bóng. Dưới chân ông, những đường sáng xanh lục lan ra thành hình trận đồ.",
    "dlg.ch1_raid_ong_mac.r8": "Hộ Tâm Trận… mười bảy năm rồi lão phu chưa bày lại.",

    "dlg.ch1_ong_mac_death.start": "Trận đồ xanh lục bùng lên như một đóa sen khổng lồ. Đồ Cuồng gầm lên, bị hất văng qua bức tường đổ.",
    "dlg.ch1_ong_mac_death.d2": "Nhưng ông Mạc cũng khuỵu xuống. Máu từ khóe miệng ông chảy dài, hòa vào nước mưa.",
    "dlg.ch1_ong_mac_death.d3": "Ông ơi! Ông bị thương rồi… để con đỡ ông dậy!",
    "dlg.ch1_ong_mac_death.d4": "Muộn rồi… Ông phá phong ấn tâm mạch để bày trận. Ngọn đèn cạn dầu thì phải tắt thôi.",
    "dlg.ch1_ong_mac_death.d5": "Nghe ông nói… Cầm lấy.",
    "dlg.ch1_ong_mac_death.d6": "Ông đặt vào tay {playerName} một miếng ngọc xanh nứt vỡ, lạnh như băng mà lại ấm như hơi thở.",
    "dlg.ch1_ong_mac_death.d7": "Thứ này… là của mẹ con. Đừng để ai biết. Đừng tin… những kẻ tự xưng là chính đạo.",
    "dlg.ch1_ong_mac_death.d8": "Cả cái hồ lô này nữa. Nó giữ được linh lực thừa… sau này con sẽ cần.",
    "dlg.ch1_ong_mac_death.d9": "Từ phía lò rèn vang lên tiếng thét xé lòng.",
    "dlg.ch1_ong_mac_death.d10": "Buông ra! {playerName}! Cứu tớ với!",
    "dlg.ch1_ong_mac_death.d11": "Một bóng áo trắng đứng trên thanh phi kiếm, lơ lửng giữa trời mưa. Hắn nhấc bổng Liên lên như nhấc một con mèo nhỏ, rồi vút đi về phương bắc.",
    "dlg.ch1_ong_mac_death.d12": "LIÊN!",
    "dlg.ch1_ong_mac_death.d13": "Đừng… đuổi theo. Con… không phải đối thủ của chúng.",
    "dlg.ch1_ong_mac_death.d14": "Chạy về phía tây… qua rừng, lên Hàn Phong Lĩnh. Ở Miếu Sơn Thần… sẽ có người… chỉ đường cho con.",
    "dlg.ch1_ong_mac_death.d15": "Hơi thở của ông Mạc mỗi lúc một yếu.",
    "dlg.ch1_ong_mac_death.d15.hold": "(Nắm chặt tay ông.)",
    "dlg.ch1_ong_mac_death.d15.cry": "Ông đừng bỏ con… Con chưa kịp báo hiếu ông ngày nào…",
    "dlg.ch1_ong_mac_death.h1": "Bàn tay này… mười bảy năm trước còn bé tí… Lớn thật rồi.",
    "dlg.ch1_ong_mac_death.c1": "Ngốc… Ông có đứa cháu ngoan như con… là được trời thương rồi.",
    "dlg.ch1_ong_mac_death.d16": "Sống… cho đàng hoàng…",
    "dlg.ch1_ong_mac_death.d17": "Bàn tay ông Mạc buông thõng. Mưa vẫn rơi, chẳng phân biệt người sống hay người chết.",
    "dlg.ch1_ong_mac_death.d18": "Trong lòng bàn tay {playerName}, miếng ngọc nứt khẽ ấm lên, như có ai đó thở dài.",

    // ---------------------------------------------------------------- Rừng đêm
    "dlg.ch1_lang_dem_intro.start": "Rừng Tây chìm trong bóng tối. Mùi máu và mưa khiến bầy sói phát cuồng.",
    "dlg.ch1_lang_dem_intro.n2": "Ba cặp mắt đỏ rực lừ lừ tiến ra từ sau những gốc thông. Con đầu đàn to gần bằng con bê.",
    "dlg.ch1_lang_dem_intro.n3": "Không thể chạy… Sói nhanh hơn mình nhiều. Phải làm chúng chậm lại!",
    "dlg.ch1_lang_dem_after.start": "Phải đi tiếp… lên núi… trước khi bọn áo đen tìm thấy mình.",
    "dlg.ch1_forest_block.start": "Bọn áo đen vẫn còn trong làng… Ông dặn phải lên núi. Không thể quay lại lúc này.",
    "dlg.ch1_vo_trang_body.start": "Dưới gốc thông, anh Võ Tráng nằm úp mặt xuống bùn. Chiếc rìu quen thuộc gãy làm đôi.",
    "dlg.ch1_vo_trang_body.b2": "Trên lưng anh cắm một mũi phi tiêu tẩm độc, đuôi buộc lông sói xám.",
    "dlg.ch1_vo_trang_body.b3": "Anh Tráng… Bọn chúng giết cả người đốn củi vô tội…",
    "dlg.ch1_vo_trang_body.b4": "{playerName} khép mắt cho anh, rồi nắm chặt miếng ngọc trong tay.",

    // ---------------------------------------------------------------- Miếu Sơn Thần
    "dlg.ch1_shrine.day": "Một ngôi miếu đá cổ, mái đã sụp, chỉ còn hai cột đá đỡ một thanh xà phủ rêu. Tượng Sơn Thần mờ hết mặt.",
    "dlg.ch1_shrine.day2": "Có ai đó vẫn đặt ở đây một nén hương còn ấm.",
    "dlg.ch1_shrine.after": "Miếu Sơn Thần im lìm trong tuyết. Gió hú qua những khe đá như một tiếng thở dài.",

    "dlg.ch1_awakening.start": "{playerName} lết vào miếu, kiệt sức. Tuyết phủ trắng vai áo, máu từ vết cào trên tay đã đông lại.",
    "dlg.ch1_awakening.a2": "Ông bảo… ở đây sẽ có người chỉ đường. Nhưng ở đây… chẳng có ai cả…",
    "dlg.ch1_awakening.a3": "Miếng ngọc nứt trong ngực áo bỗng nóng rực. Ánh sáng xanh biếc tràn ra, nhuộm cả ngôi miếu đổ nát.",
    "dlg.ch1_awakening.a4": "Ngươi… nghe thấy ta không?",
    "dlg.ch1_awakening.a5": "Giọng nói trong giấc mơ…! Ai? Ai đang nói?",
    "dlg.ch1_awakening.a6": "Đừng la. Lão phu vừa tỉnh, đầu còn ong ong như có ai gõ chuông bên tai.",
    "dlg.ch1_awakening.a7": "Lão phu là… là ai nhỉ? Hừm. Tên tuổi rơi đâu mất cả rồi. Chỉ còn lại một mảnh tàn hồn mắc kẹt trong khối ngọc vỡ này.",
    "dlg.ch1_awakening.a8": "Cứ gọi là Ngọc lão. Nghe cũng có khí phách đấy chứ.",
    "dlg.ch1_awakening.a9": "Ánh ngọc chập chờn, như một con mắt đang chờ đợi.",
    "dlg.ch1_awakening.a9.trust": "Ông Mạc dặn con đến đây. Ông ấy… biết người sao?",
    "dlg.ch1_awakening.a9.wary": "Một hồn ma trong ngọc. Tại sao tôi phải tin ông?",
    "dlg.ch1_awakening.a9.angry": "Vì cái thứ này mà bọn chúng giết ông tôi, đốt làng tôi!",
    "dlg.ch1_awakening.t1": "Mạc Tùng… cái tên ấy lão phu có nhớ. Một kẻ cứng đầu, nhưng là người tốt. Hắn đã giữ lời.",
    "dlg.ch1_awakening.w1": "Tốt. Ở thế giới này, kẻ dễ tin người thường chết sớm. Cứ nghi ngờ lão phu, nhưng hãy nghe hết đã.",
    "dlg.ch1_awakening.g1": "…Ngươi nói đúng. Chúng tìm khối ngọc này. Lão phu không chối.",
    "dlg.ch1_awakening.g2": "Nhưng kẻ cầm đao là chúng, không phải ngươi, cũng không phải lão già họ Mạc. Giận thì cứ giận, nhưng đừng để cơn giận giết ngươi trước.",
    "dlg.ch1_awakening.a10": "Nghe đây, {g:tiểu tử|nha đầu|tiểu gia hỏa}. Bầy chó săn của chúng đang lần theo mùi máu của ngươi. Chừng một nén nhang nữa là tới.",
    "dlg.ch1_awakening.a11": "Tôi… tôi không có linh căn. Tôi không thể tu luyện, làm sao đánh lại tu sĩ?",
    "dlg.ch1_awakening.a12": "Linh căn?",
    "dlg.ch1_awakening.a13": "Ha… ha ha ha! Lại là cái thứ ấy. Mười nghìn năm rồi mà thiên hạ vẫn tin vào cái thứ ấy.",
    "dlg.ch1_awakening.a14": "Có một con đường không cần linh căn. Con đường đi bằng máu thịt, bằng sinh tử, bằng chính ý chí không chịu cúi đầu.",
    "dlg.ch1_awakening.a15": "Nó tên là Nghịch Mệnh Quyết. Đau lắm đấy. Có khi đau đến chết. Ngươi có dám không?",
    "dlg.ch1_awakening.a16": "Ngoài miếu, gió tuyết gào thét.",
    "dlg.ch1_awakening.a16.yes": "Dám. Nếu đó là cách duy nhất để sống… và để cứu Liên.",
    "dlg.ch1_awakening.a16.ask": "Cái giá là gì?",
    "dlg.ch1_awakening.k1": "Mỗi bước tiến là một lần xé thịt rèn xương. Dùng quá đà, tâm ma sẽ tìm đến. Và trời đất sẽ coi ngươi như cái gai trong mắt.",
    "dlg.ch1_awakening.k2": "…Tôi vẫn đi.",
    "dlg.ch1_awakening.a17": "Tốt! Ngồi xuống. Hít vào. Cảm nhận dòng máu chảy trong người — đó chính là linh khí đầu tiên của ngươi.",
    "dlg.ch1_awakening.a18": "Một luồng nóng rực xé toạc kinh mạch. {playerName} cắn chặt răng, máu rỉ ra từ khóe môi, mồ hôi hòa với tuyết tan.",
    "dlg.ch1_awakening.a19": "Rồi giữa cơn đau, có thứ gì đó vỡ ra — như con đê ngăn lũ cuối cùng cũng sụp đổ.",
    "dlg.ch1_awakening.a20": "{playerName} đã bước vào Luyện Khí sơ kỳ. Lĩnh ngộ Phá Thạch Quyền và Tụ khí.",
    "dlg.ch1_awakening.a21": "Được! Không tồi, không tồi chút nào. Giờ thì nghe kỹ: Nghịch Mệnh Quyết sống nhờ Tụ khí.",
    "dlg.ch1_awakening.a22": "Gom lực vào một điểm, giữ nó qua từng hơi thở, rồi tung ra một đòn. Gom càng lâu đòn càng nặng — nhưng bị đánh trúng lúc đang gom thì công cốc.",
    "dlg.ch1_awakening.a23": "Bên ngoài, tiếng sói tru vang lên. Rồi một tràng cười khàn khàn.",
    "dlg.ch1_awakening.a24": "Mùi máu tươi thơm quá… Con chuột nhắt trốn trong miếu à? Ra đây, Lang Nha này chơi với mày một chút.",
    "dlg.ch1_awakening.a25": "Kẻ này chuyên phóng phi tiêu ngắt người gom lực quá lộ liễu. Gom vừa đủ, rồi tung đòn trước khi hắn kịp ra tay.",

    "dlg.ch1_after_lang_nha.start": "Khụ… Một đứa không linh căn mà… Đồ đại ca… sẽ không tha cho mày…",
    "dlg.ch1_after_lang_nha.n2": "Lang Nha gục xuống tuyết. Từ ngực áo hắn rơi ra một phong thư lệnh, đóng dấu hình đám mây xanh.",
    "dlg.ch1_after_lang_nha.n3": "Dấu mây… Lão phu không nhớ của môn phái nào, nhưng chắc chắn không phải ma đạo. Ma đạo chẳng bao giờ đóng dấu lên tội ác của mình.",
    "dlg.ch1_after_lang_nha.n4": "Kẻ giết ông… là người của chính đạo sao?",
    "dlg.ch1_after_lang_nha.n5": "Chính hay tà, cứ nhìn việc chúng làm. Trời sắp sáng rồi. Về làng đi, {g:tiểu tử|nha đầu|tiểu gia hỏa}. Người chết cần được chôn cất.",

    // ---------------------------------------------------------------- Bình minh
    "dlg.ch1_ly_duc_dawn.start": "{playerName}… cháu còn sống. Trời thương…",
    "dlg.ch1_ly_duc_dawn.n2": "Làng mình… mất hơn nửa. Lão Sơn, vợ lão, anh Tráng… và bao nhiêu người nữa.",
    "dlg.ch1_ly_duc_dawn.n3": "Ông Mạc nằm trước sân nhà. Cháu… lo hậu sự cho ông đi. Bà con sẽ giúp một tay.",
    "dlg.ch1_ly_duc_dawn.hint": "Còn nữa… trong sân nhà cháu có rơi một thứ, ta không dám đụng vào.",
    "dlg.ch1_thim_ba_dawn.saved": "Thằng Đậu ngủ rồi. Nó cứ nắm chặt vạt áo thím, không chịu buông.",
    "dlg.ch1_thim_ba_dawn.s2": "Nếu đêm qua con không cõng nó ra… thím không dám nghĩ tiếp.",
    "dlg.ch1_thim_ba_dawn.lost": "Người ta tìm thấy cái gốc cây cháy rụi… mà không thấy thằng Đậu đâu cả.",
    "dlg.ch1_thim_ba_dawn.l2": "Có người bảo thấy bọn áo đen bắt mấy đứa trẻ đi. Có khi nó còn sống… phải không con?",
    "dlg.ch1_dau_dawn.start": "{g:Anh |Chị |}{playerName}… chị Liên bị bắt đi rồi. {g:Anh|Chị|Bạn} sẽ cứu chị ấy về, đúng không?",
    "dlg.ch1_dau_dawn.n2": "Bé Đậu ngước lên, đôi mắt sưng mọng.",
    "dlg.ch1_dau_dawn.n2.promise": "Ừ. Nhất định.",
    "dlg.ch1_dau_dawn.n2.silent": "(Xoa đầu bé, không nói gì.)",
    "dlg.ch1_dau_dawn.p1": "Vậy em sẽ luyện ném sỏi thật giỏi, để sau này đi cùng {g:anh|chị|bạn}!",
    "dlg.ch1_dau_dawn.s1": "…Em hiểu rồi.",
    "dlg.ch1_grave.bury": "Bà con trong làng đào cho ông Mạc một nấm mộ dưới gốc đào ông trồng năm nào.",
    "dlg.ch1_grave.b2": "Không có quan tài, chỉ có manh chiếu cói và mùi thuốc bắc còn vương trên áo ông.",
    "dlg.ch1_grave.b3": "Khói hương lượn lờ trong gió sớm.",
    "dlg.ch1_grave.b3.vow": "(Thề sẽ tìm ra kẻ đứng sau.)",
    "dlg.ch1_grave.b3.thank": "(Cảm ơn ông đã nuôi mình khôn lớn.)",
    "dlg.ch1_grave.v1": "Ông ơi, con thề sẽ tìm ra kẻ đứng sau đêm nay. Bất kể chúng là ai.",
    "dlg.ch1_grave.t1": "Con cảm ơn ông. Con sẽ sống cho đàng hoàng, như ông dặn.",
    "dlg.ch1_grave.b4": "Trong túi áo ông Mạc có một cuốn sổ thuốc cũ. Giữa những trang chép bài thuốc là vài ký hiệu lạ, như một tấm bản đồ.",
    "dlg.ch1_grave.visit": "Nấm mộ ông Mạc nằm yên dưới gốc đào. Một nén hương còn cháy dở.",
    "dlg.ch1_hu_thuoc.start": "Góc nhà ông Mạc còn sót một hũ sành nhỏ, nắp buộc lạt đỏ. Lửa đã liếm đen cả vách, vậy mà hũ thuốc vẫn còn nguyên.",
    "dlg.ch1_hu_thuoc.h2": "Bên trong là hai viên đan màu hổ phách và một gói thuốc trị thương. Mùi thuốc bắc quen thuộc làm sống mũi cay cay.",
    "dlg.ch1_hu_thuoc.h3": "Tụ Khí Đan… lão lang băm này giấu kỹ thật. Phàm nhân nuốt vào chỉ thấy ấm bụng, nhưng với kẻ đã nhập Luyện Khí thì là của quý.",
    "dlg.ch1_hu_thuoc.h4": "Lúc nào yên ổn thì mở túi ra mà dùng. Đừng có nuốt giữa lúc đánh nhau — dược lực cần thời gian mới thấm vào kinh mạch.",
    "dlg.ch1_token.start": "Giữa bùn và tro, một tấm lệnh bài bằng gỗ mun khẽ lóe sáng. Mặt trước khắc hai chữ: Ngoại Môn.",
    "dlg.ch1_token.t2": "Mặt sau là hình đám mây xanh — giống hệt con dấu trên thư lệnh của Lang Nha.",
    "dlg.ch1_token.t3": "Lệnh bài ngoại môn… của Thanh Huyền Môn, cái tông môn từng xuống đây đo linh căn. Thú vị thật.",
    "dlg.ch1_token.t4": "Thanh Huyền Môn… Liên sắp được nhận vào đó. Vậy mà bọn giết người cũng đến từ đó sao?",
    "dlg.ch1_farewell.start": "Cháu định đi đâu?",
    "dlg.ch1_farewell.f2": "Lên Thanh Huyền Môn. Cháu phải biết ai đã ra lệnh đêm qua. Và Liên… cháu phải tìm cậu ấy.",
    "dlg.ch1_farewell.f3": "Thân phàm nhân mà đòi vào tông môn tu tiên… Ông Mạc mà biết chắc lại cốc đầu cháu.",
    "dlg.ch1_farewell.f4": "Nhưng ta không cản. Cầm lấy ít lộ phí, và cái này nữa — thuốc trị thương ông Mạc để lại.",
    "dlg.ch1_farewell.f5": "Hang cọp mới có cọp con. Muốn biết sự thật thì phải vào tận bên trong. Đi thôi.",
    "dlg.ch1_farewell.f6": "{playerName} ngoái nhìn Thanh Khê lần cuối. Khói vẫn còn bốc lên từ những mái nhà cháy rụi.",
    "dlg.ch1_ly_duc_after.start": "Đường lên Thanh Huyền Sơn ở phía bắc, qua Hàn Phong Lĩnh. Đi đường cẩn thận, cháu ạ.",
}
