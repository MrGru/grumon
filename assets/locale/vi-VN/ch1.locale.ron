    "card.ch1_end.title": "Hết Chương 1 — Phàm Trần Huyết Kiếp",
    "card.ch1_end.subtitle": "Hành trình sẽ tiếp tục ở Chương 2 — Ngoại Môn Phong Vân.\nHành trình đã được tự động lưu. Bạn vẫn có thể dạo quanh Thanh Khê.",

    // ---------------------------------------------------------------- Nhân vật
    "char.ong_mac.name": "Ông Mạc",
