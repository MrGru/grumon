// Vật phẩm, chiêu thức, pháp bảo, trận pháp, trạng thái — bản gốc tiếng Việt.
{
    // ---------------------------------------------------------------- Vật phẩm
    "item.banh_dau_xanh.name": "Bánh Đậu Xanh",
    "item.banh_dau_xanh.desc": "Bánh của thím Ba, ngọt bùi thơm mỡ hành. Hồi 30% khí huyết cho một người.",
    "item.soi_nem.name": "Sỏi Ném",
    "item.soi_nem.desc": "Hòn sỏi tròn nhẵn. Ném trúng gây chút sát thương và đẩy lượt kẻ địch lùi 250 tích.",
    "item.khoi_me_huong.name": "Khói Mê Hương",
    "item.khoi_me_huong.desc": "Gói hương thảo mộc, đốt lên khói cay xè. Đẩy lượt của mọi kẻ địch lùi 300 tích.",
    "item.thuoc_tri_thuong.name": "Thuốc Trị Thương",
    "item.thuoc_tri_thuong.desc": "Thuốc bột gia truyền của ông Mạc. Hồi 45% khí huyết và giải trạng thái xấu.",
    "item.hoi_khi_tan.name": "Hồi Khí Tán",
    "item.hoi_khi_tan.desc": "Bột thuốc màu lam nhạt. Hồi 50% linh lực cho một người.",
    "item.tu_khi_dan.name": "Tụ Khí Đan",
    "item.tu_khi_dan.desc": "Viên đan màu hổ phách, cầm lên thấy ấm tay. Dùng ngoài trận: tăng 40 tu vi cho một người đã nhập Luyện Khí.",
    "item.thanh_tam_thao.name": "Thanh Tâm Thảo",
    "item.thanh_tam_thao.desc": "Cỏ lá xanh lam mọc dưới bóng thông, vị đắng mát, trị ho và an thần.",
    "item.phe_dan.name": "Phế Đan",
    "item.phe_dan.desc": "Viên đan cháy khét, đen sì vì lửa quá tay. Chỉ bán được vài đồng.",
    "item.huyen_thiet.name": "Huyền Thiết",
    "item.huyen_thiet.desc": "Quặng sắt đen nặng trịch, thấm linh khí. Dùng để luyện khí, tăng uy lực pháp bảo.",
    "recipe.tri_thuong_tan.name": "Thuốc Trị Thương",
    "item.linh_lang_nanh.name": "Nanh Linh Lang",
    "item.linh_lang_nanh.desc": "Chiếc nanh dài, lạnh buốt. Thương nhân tu sĩ thường thu mua để luyện khí.",
    "item.da_tru_nanh.name": "Nanh Dã Trư",
    "item.da_tru_nanh.desc": "Nanh lợn rừng vàng ố, người trong thôn hay mài làm cán dao.",
    "item.go_dao.name": "Gỗ Đào",
    "item.go_dao.desc": "Khúc gỗ đào trôi dạt, thớ mịn và thơm, rất hợp để khắc đồ nhỏ.",
    "item.ca_suoi.name": "Cá Chép Suối",
    "item.ca_suoi.desc": "Con cá chép béo múp của chú Năm Chài, vẫn còn quẫy.",
    "item.con_dieu.name": "Diều Rồng",
    "item.con_dieu.desc": "Con diều giấy bé Đậu tự vẽ hình rồng. Rồng trông hơi giống con giun.",
    "item.dao_khac.name": "Dao Khắc",
    "item.dao_khac.desc": "Con dao nhỏ lưỡi bén của chú Sơn thợ rèn.",
    "item.tram_go_hoa_sen.name": "Trâm Gỗ Hoa Sen",
    "item.tram_go_hoa_sen.desc": "Cây trâm gỗ đào khắc hình hoa sen. Không đẹp lắm, nhưng từng nhát dao đều thật lòng.",
    "item.tan_ngoc.name": "Tàn Ngọc",
    "item.tan_ngoc.desc": "Miếng ngọc xanh biếc nứt vỡ, lạnh như băng mà ấm như hơi thở. Di vật của mẹ, ông Mạc trao lại.",
    "item.so_thuoc_ong_mac.name": "Sổ Thuốc Của Ông Mạc",
    "item.so_thuoc_ong_mac.desc": "Cuốn sổ chép tay các bài thuốc. Giữa các trang có vài ký hiệu lạ, như một tấm bản đồ.",
    "item.lenh_bai_ngoai_mon.name": "Lệnh Bài Ngoại Môn",
    "item.lenh_bai_ngoai_mon.desc": "Lệnh bài gỗ mun khắc hai chữ Ngoại Môn, mặt sau có hình đám mây xanh.",
    "item.thu_lenh_dau_may.name": "Thư Lệnh Dấu Mây",
    "item.thu_lenh_dau_may.desc": "Phong thư lệnh không đề tên, đóng dấu đám mây xanh. Rơi ra từ người Lang Nha.",

    // ---------------------------------------------------------------- Chiêu thức
    "skill.quet_gay.name": "Quét Gậy",
    "skill.quet_gay.desc": "Vung gậy quét một vòng, đánh trúng mọi kẻ địch (55% Công).",
    "skill.pha_thach_quyen.name": "Phá Thạch Quyền",
    "skill.pha_thach_quyen.desc": "Quyền đầu tiên của Nghịch Mệnh Quyết, hệ Thổ (220% Công). Tiêu hết Tụ khí để nhân sát thương; từ bậc 2 gây Phá giáp.",
    "skill.nghich_menh_chi.name": "Nghịch Mệnh Chỉ",
    "skill.nghich_menh_chi.desc": "Một chỉ xuyên thấu (260% Công), ngắt ngang kẻ đang niệm chú. Tụ khí bậc 3 trở lên gây Choáng. Lượt sau đến chậm hơn.",
    "skill.thanh_moc_cham.name": "Thanh Mộc Châm",
    "skill.thanh_moc_cham.desc": "Kim gỗ xanh tẩm linh lực hệ Mộc (120% Pháp), khiến mục tiêu Chậm 2 lượt.",
    "skill.duong_sinh_quyet.name": "Dưỡng Sinh Quyết",
    "skill.duong_sinh_quyet.desc": "Truyền sinh khí hệ Mộc, hồi khí huyết (160% Pháp) và giải trạng thái xấu cho một đồng đội.",
    "skill.phong_linh.name": "Phóng Linh",
    "skill.phong_linh.desc": "Giải phóng linh lực cất trong hồ lô và tích ngay một bậc Tụ khí, không tính vào giới hạn mỗi lượt.",
    "skill.huyen_quy_ho_the.name": "Huyền Quy Hộ Thể",
    "skill.huyen_quy_ho_the.desc": "Dựng khiên mai rùa cho một đồng đội (60% Pháp + 30).",
    "skill.thanh_van_kiem_vu.name": "Thanh Vân Kiếm Vũ",
    "skill.thanh_van_kiem_vu.desc": "Phi kiếm chém liên tiếp 3 nhát (45% Công mỗi nhát), thêm một nhát nếu nhanh hơn mục tiêu.",
    "skill.tran_hon_chuong.name": "Trấn Hồn Chuông",
    "skill.tran_hon_chuong.desc": "Tiếng chuông ngắt ngang thần chú và đẩy lùi lượt mục tiêu 250 tích.",
    "skill.ngu_hanh_doi_ky.name": "Ngũ Hành Đổi Kỳ",
    "skill.ngu_hanh_doi_ky.desc": "Cắm lá cờ hệ Hỏa, đổi hệ của một đồng đội trong 2 lượt.",
    "skill.huyen_anh_phan_than.name": "Huyễn Ảnh Phân Thân",
    "skill.huyen_anh_phan_than.desc": "Tạo ảo ảnh cho một đồng đội: đòn đơn mục tiêu kế tiếp nhắm vào người ấy sẽ trượt.",
    "skill.xich_viem_bao.name": "Xích Viêm Bạo",
    "skill.xich_viem_bao.desc": "Thiêu hết Tụ khí thành lửa (120% Pháp mỗi bậc) và gây Bỏng. Người dùng bị Quá nhiệt.",
    "skill.hon_dang_phe_anh.name": "Hồn Đăng Phệ Ảnh",
    "skill.hon_dang_phe_anh.desc": "Đèn hồn hút 20 linh lực của mục tiêu, chia cho đồng đội.",
    "skill.truy_phong_bo.name": "Truy Phong Bộ",
    "skill.truy_phong_bo.desc": "Thúc lượt của một đồng đội đến sớm hơn 300 tích.",
    "skill.bach_thao_luyen.name": "Bách Thảo Luyện",
    "skill.bach_thao_luyen.desc": "Niệm 800 tích, rồi hồi 35% khí huyết và giải trạng thái xấu cho cả đội.",
    "skill.pha_son_tran.name": "Phá Sơn Trấn",
    "skill.pha_son_tran.desc": "Ấn núi đè xuống: kẻ đang niệm chú bị Choáng, nếu không thì chịu sát thương hệ Thổ.",
    "skill.kiem_phoi_tram.name": "Kiếm Phôi Trảm",
    "skill.kiem_phoi_tram.desc": "Chém bằng phôi kiếm bản mệnh (170% Công), có thể Tụ khí.",
    "skill.chieu_hon_trieu.name": "Chiêu Hồn",
    "skill.chieu_hon_trieu.desc": "Phất cờ gọi một Oán Hồn Vệ đứng hàng Tiền. Nó hút mọi đòn đánh đơn trong hai lượt rồi tan biến.",
    "skill.thanh_van_kiem_quyet.name": "Thanh Vân Kiếm Quyết",
    "skill.thanh_van_kiem_quyet.desc": "Hai nhát kiếm liền (75% Công mỗi nhát). Tụ khí bậc 2: thêm một nhát; bậc 3: gây Phá giáp.",
    "skill.han_bang_chuong.name": "Hàn Băng Chưởng",
    "skill.han_bang_chuong.desc": "Chưởng lực băng giá (130% Pháp). Tụ khí bậc 1: gây Chậm; bậc 3: đóng băng gây Choáng.",
    "skill.liet_hoa_phan_thien.name": "Liệt Hỏa Phần Thiên",
    "skill.liet_hoa_phan_thien.desc": "Biển lửa thiêu toàn bộ kẻ địch (80% Pháp). Tụ khí bậc 2: gây Bỏng.",
    "skill.hon_hoa_phe_linh.name": "Hồn Hỏa Phệ Linh",
    "skill.hon_hoa_phe_linh.desc": "Lửa hồn đốt kẻ địch (90% Pháp) và hút 10 linh lực. Tụ khí bậc 2: hút thêm 15; bậc 3: Phong ấn.",
    "skill.moc_linh_hoi_xuan.name": "Mộc Linh Hồi Xuân",
    "skill.moc_linh_hoi_xuan.desc": "Mưa xuân hồi khí huyết cho cả đội (70% Pháp). Tụ khí bậc 2: giải trạng thái xấu; bậc 3: ban Hộ tâm.",

    // ---------------------------------------------------------------- Pháp bảo
    "artifact.tu_linh_ho_lo.name": "Tụ Linh Hồ Lô",
    "artifact.tu_linh_ho_lo.desc": "Pháp khí. Tự cất linh lực thừa (tối đa 30). Phóng Linh: trả linh lực và tích ngay một bậc Tụ khí. 2 lần mỗi trận.",
    "artifact.tu_linh_ho_lo.lore": "Chiếc hồ lô đựng thuốc ông Mạc đeo bên hông suốt mười bảy năm.",
    "artifact.huyen_quy_thuan.name": "Huyền Quy Thuẫn",
    "artifact.huyen_quy_thuan.desc": "Linh khí. Tạo khiên cho đồng đội; sát thương bị khiên chặn hóa thành trận lực. Đòn ngắt quãng xuyên qua khiên.",
    "artifact.huyen_quy_thuan.lore": "Mai của một con rùa đen nghìn tuổi, ông Mạc luyện thành khi còn là trưởng lão.",
    "artifact.thanh_van_phi_kiem.name": "Thanh Vân Phi Kiếm",
    "artifact.thanh_van_phi_kiem.desc": "Linh khí. Chém liên hoàn, càng nhanh càng nhiều nhát; yếu trước kẻ đang Thủ thế.",
    "artifact.tran_hon_linh.name": "Trấn Hồn Linh",
    "artifact.tran_hon_linh.desc": "Linh khí. Ngắt thần chú và đẩy lùi lượt. Hồi chiêu dài; cường địch kháng dần.",
    "artifact.ngu_hanh_ky.name": "Ngũ Hành Kỳ",
    "artifact.ngu_hanh_ky.desc": "Linh khí. Đổi hệ của một đồng đội trong 2 lượt để khắc chế hoặc kích hoạt Tương sinh.",
    "artifact.huyen_anh_kinh.name": "Huyễn Ảnh Kính",
    "artifact.huyen_anh_kinh.desc": "Linh khí. Tạo ảo ảnh khiến đòn đơn mục tiêu kế tiếp trượt; vô dụng trước đòn diện rộng.",
    "artifact.xich_viem_chau.name": "Xích Viêm Châu",
    "artifact.xich_viem_chau.desc": "Pháp bảo. Thiêu hết Tụ khí thành một đòn lửa; dùng nhiều sẽ Quá nhiệt tự thiêu.",
    "artifact.ban_menh_kiem_phoi.name": "Bản Mệnh Kiếm Phôi",
    "artifact.ban_menh_kiem_phoi.desc": "Bản mệnh pháp bảo. Phôi kiếm gắn với chủ nhân, sẽ tiến hóa theo những lần đột phá.",
    "artifact.hon_dang.name": "Hồn Đăng",
    "artifact.hon_dang.desc": "Linh khí. Hút linh lực của kẻ địch chia cho đồng đội.",
    "artifact.truy_phong_ngoa.name": "Truy Phong Ngoa",
    "artifact.truy_phong_ngoa.desc": "Pháp khí. +5 Thân pháp. Thúc lượt của đồng đội đến sớm hơn.",
    "artifact.bach_thao_dinh.name": "Bách Thảo Đỉnh",
    "artifact.bach_thao_dinh.desc": "Pháp bảo. Luyện thuốc ngay giữa trận: niệm lâu rồi hồi phục cả đội. Có thể bị ngắt.",
    "artifact.pha_son_an.name": "Phá Sơn Ấn",
    "artifact.pha_son_an.desc": "Pháp bảo. Làm Choáng kẻ đang niệm chú; Kiên định thì không có tác dụng.",
    "artifact.chieu_hon_phien.name": "Chiêu Hồn Phiên",
    "artifact.chieu_hon_phien.desc": "Pháp bảo. Lá cờ đen thêu chú văn, gọi Oán Hồn Vệ chắn đòn cho đồng đội trong hai lượt. Đòn đánh lan không bị nó hút.",
    "summon.oan_hon_ve.name": "Oán Hồn Vệ",

    // ---------------------------------------------------------------- Trận pháp
    "formation.ho_tam_tran.name": "Hộ Tâm Trận",
    "formation.ho_tam_tran.desc": "Tầng 1: mỗi lượt nhận Hộ tâm, giữ Tụ khí khi bị đánh. Tầng 2: khiên 15% khí huyết. Tầng 3: giải trạng thái xấu, khiên 30%.",
    "formation.tam_tai_kiem_tran.name": "Tam Tài Kiếm Trận",
    "formation.tam_tai_kiem_tran.desc": "Cần 3 người. Tầng 1: +15% Công. Tầng 2: mọi trận nhãn cùng chém. Tầng 3: ba đợt kiếm đồng loạt.",
    "formation.ngu_hanh_tran.name": "Ngũ Hành Tương Sinh Trận",
    "formation.ngu_hanh_tran.desc": "Cần 2 hệ khác nhau. Tầng 1: hồi thêm linh lực, Tương sinh nạp thêm trận lực. Tầng 2: hồi 20% linh lực cả đội.",
    "formation.pha_linh_tran.name": "Phá Linh Trận",
    "formation.pha_linh_tran.desc": "Tầng 1: +10% Công. Tầng 2: ngắt mọi thần chú của địch. Phát trận: Phá giáp và Phong ấn toàn bộ kẻ địch.",
    "formation.luong_nghi_tran.name": "Lưỡng Nghi Trận",
    "formation.luong_nghi_tran.desc": "Cần 2 người. Tầng 1: Đổi vị trí không tốn ĐHĐ. Tầng 2: cả đội được thúc lượt. Phát trận: kéo mọi trận nhãn lên hành động ngay.",
    "formation.cuu_cung_me_tran.name": "Cửu Cung Mê Trận",
    "formation.cuu_cung_me_tran.desc": "Cần 3 người. Tầng 1: người hàng Hậu nhận Hư ảnh. Tầng 2: mê trận làm Chậm mọi kẻ địch. Phát trận: cả đội nhận Hư ảnh, đẩy lượt kẻ địch lùi.",

    // ---------------------------------------------------------------- Trạng thái
    "status.bong.name": "Bỏng",
    "status.bong.desc": "Mất 6% khí huyết đầu mỗi lượt.",
    "status.doc.name": "Trúng độc",
    "status.doc.desc": "Mất 4% khí huyết đầu mỗi lượt, hiệu quả hồi phục giảm một nửa.",
    "status.choang.name": "Choáng",
    "status.choang.desc": "Mất lượt kế tiếp.",
    "status.kien_dinh.name": "Kiên định",
    "status.kien_dinh.desc": "Miễn nhiễm Choáng.",
    "status.phong_an.name": "Phong ấn",
    "status.phong_an.desc": "Không thể dùng chiêu thức hay pháp bảo tốn linh lực.",
    "status.cham.name": "Chậm",
    "status.cham.desc": "Thân pháp giảm 30%.",
    "status.tang_toc.name": "Tăng tốc",
    "status.tang_toc.desc": "Thân pháp tăng 30%.",
    "status.pha_giap.name": "Phá giáp",
    "status.pha_giap.desc": "Thủ giảm 40%.",
    "status.cuong_cong.name": "Cường công",
    "status.cuong_cong.desc": "Công và Pháp tăng 30%.",
    "status.ho_tam.name": "Hộ tâm",
    "status.ho_tam.desc": "Lần sau bị ngắt Tụ khí chỉ mất một bậc.",
    "status.thu_the.name": "Thủ thế",
    "status.thu_the.desc": "Chỉ chịu một nửa sát thương đến lượt sau; giữ Tụ khí khi bị đánh mạnh.",
    "status.khien.name": "Khiên",
    "status.khien.desc": "Hấp thụ sát thương trước khí huyết.",
    "status.hu_anh.name": "Hư ảnh",
    "status.hu_anh.desc": "Đòn đơn mục tiêu kế tiếp sẽ trượt.",
    "status.khieu_khich.name": "Khiêu khích",
    "status.khieu_khich.desc": "Kẻ địch buộc phải nhắm vào người này.",
    "status.qua_nhiet.name": "Quá nhiệt",
    "status.qua_nhiet.desc": "Tích đủ 3 tầng sẽ tự thiêu mất 15% khí huyết.",

    // ---------------------------------------------------------------- Đồng hành (Chương 2+)
    "char.diep_han_suong.name": "Diệp Hàn Sương",
    "char.au_duong_liet.name": "Âu Dương Liệt",
    "char.ta_vo_uu.name": "Tạ Vô Ưu",
